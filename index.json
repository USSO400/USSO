            display: none;
}
        .leader-card.air-control:hover .radar-mini { display: block;
}
        .radar-sweep-mini {
            position: absolute; top: 50%; left: 50%; width: 100%; height: 100%;
            transform-origin: 0% 0%;
            background: linear-gradient(90deg, rgba(220,
  20,
  60,
  0) 0%, rgba(220,
  20,
  60,
  0.8) 50%, rgba(220,
  20,
  60,
  0) 100%);
            opacity: 0.6; animation: radarSweep 2s linear infinite;
}
        .aircraft-marker-mini {
            position: absolute; width: 6px; height: 6px; background-color: var(--color-white);

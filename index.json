}
        .leader-card:hover .leader-description {
            opacity: 1;
            max-height: 150px; /* Adjust as needed */
}
/* Specific leader styling */
        .leader-card.president .leader-avatar { border-color: var(--color-crimson-red);
}
        .leader-card.president .leader-name { font-size: 2.8em; text-shadow: 0 0 15px var(--color-crimson-red);
}
        .leader-card.president .leader-title { font-size: 1.5em; color: var(--color-white);
}
        .leader-card.private .leader-title { color: var(--color-white);
}
        .leader-card.private .leader-description { color: var(--color-crimson-red); font-weight: bold;
}
/* Air Control Ahmad specific visuals */

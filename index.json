}
/* --- CONTINENT / MAP SECTION --- */
        #territories-section {
            text-align: center;
            position: relative;
}
        .continent-map-wrapper {
            position: relative;
            width: 100%;
            height: 70vh;
            background-color: var(--color-black);
            border: 2px solid var(--color-crimson-red);
            border-radius: var(--border-radius-lg);
            margin: 40px auto;
            overflow: hidden;
            box-shadow: 0 0 30px var(--color-crimson-red);
            cursor: grab;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1000px;

}
        .modal-close-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--color-dark-gray);
            color: var(--color-white);
            border: 1px solid var(--color-crimson-red);
            border-radius: 50%;
            width: 35px;
            height: 35px;

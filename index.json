            border: 2px solid var(--color-black);
            border-radius: var(--border-radius-lg);
            padding: 30px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0,
  0,
  0,
  0.6);
            position: relative;
            overflow: hidden;
            transition: all var(--transition-speed) ease;
            cursor: pointer;
}
        .leader-card:hover {
            transform: translateY(-10px) scale(1.03);
            border-color: var(--color-crimson-red);
            box-shadow: 0 0 30px var(--color-crimson-red);
}
        .leader-card-bg-glow {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(220,
  20,
  60,
  0.2) 0%, transparent 70%);
            opacity: 0;
            transition: opacity var(--transition-speed) ease;
}
        .leader-card:hover .leader-card-bg-glow { opacity: 1;
}
        .leader-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background-color: var(--color-black);
            border: 3px solid var(--color-white);
            margin: 0 auto 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: var(--font-family-title);
            font-size: 1.8em;
            font-weight: 700;
            color: var(--color-crimson-red);
            overflow: hidden;
            position: relative;
            z-index: 1;
}
        .leader-avatar img {
            width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
}
        .leader-name {
            font-family: var(--font-family-title);
            font-size: 2.2em;
            color: var(--color-white);
            margin-bottom: 5px;
            text-shadow: 0 0 10px rgba(255,
  255,
  255,
  0.3);
            position: relative; z-index: 1;
}
        .leader-title {
            font-size: 1.1em;
            color: var(--color-crimson-red);
            margin-bottom: 15px;
            position: relative; z-index: 1;

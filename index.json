}
        .flying-vehicle-light:nth-child(2) { top: 40%; left: -30%; --delay: 5s; animation-duration: 20s; transform: rotateZ(-10deg);
}
        .flying-vehicle-light:nth-child(3) { top: 60%; left: -60%; --delay: 10s; animation-duration: 10s; transform: rotateZ(15deg);
}

        .capital-location-grid {

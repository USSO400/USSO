}
        .airspace-status-mini {
            font-size: 0.8em; color: var(--color-crimson-red); margin-top: 10px;
            display: none;
}
        .leader-card.air-control:hover .airspace-status-mini { display: block;
}
/* --- GOVERNMENT SECTION --- */
        #government-section {

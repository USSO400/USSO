        .map-location-point.active-region { background-color: var(--color-crimson-red); box-shadow: 0 0 15px var(--color-crimson-red);
}
        .map-location-point:hover { transform: scale(1.3); box-shadow: 0 0 20px var(--color-crimson-red);
}

        .location-info-panel {
            position: absolute;

            justify-content: center;
            align-items: center;
            transition: all var(--transition-speed);
}
        .modal-close-btn:hover {
            background: var(--color-crimson-red);
            transform: scale(1.1);
}
/* --- LEADERSHIP SECTION --- */
        .leadership-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px,
  1fr));
            gap: 35px;
            margin-top: 40px;
}
        .leader-card {

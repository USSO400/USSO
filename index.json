<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THE UNITED STATES OF SEX OFFENDERS - Central Digital Headquarters</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@404;700&family=Oswald:wght@400;700&display=swap" rel="stylesheet">
    <style>
        /* --- GLOBAL & BASE STYLES --- */
:root {
            --color-black: #000000;
            --color-white: #FFFFFF;
            --color-crimson-red: #DC143C; /* Dominant accent red */
            --color-dark-gray: #333333;
            --color-light-gray: #CCCCCC;
            --color-text-secondary: #AAAAAA;

            --font-family-title: 'Oswald', sans-serif;
            --font-family-body: 'Montserrat', sans-serif;
            --transition-speed: 0.4s;
            --border-radius-lg: 12px;
            --border-radius-md: 8px;
            --z-index-nav: 100;
            --z-index-modal: 1000;
            --z-index-intro: 2000;
}
/* Basic Reset */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
}

        body {
            font-family: var(--font-family-body);
            background-color: var(--color-black);
            color: var(--color-white);
            overflow: hidden; /* Controlled by JS for main content */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            cursor: default;
            position: relative;
}

        a {
            color: var(--color-crimson-red);
            text-decoration: none;
            transition: color var(--transition-speed);
}
        a:hover {
            color: var(--color-white);
            text-shadow: 0 0 5px var(--color-crimson-red);
}

        button {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--color-white);
            font-family: var(--font-family-body);
            font-size: 1em;
            padding: 0;
}
/* Scrollbar Styling (Modern Browsers) */
: :-webkit-scrollbar { width: 8px;
}
        : :-webkit-scrollbar-track { background: var(--color-dark-gray);
}
        : :-webkit-scrollbar-thumb {
            background: var(--color-crimson-red);
            border-radius: 4px;
            transition: background var(--transition-speed);
}
        : :-webkit-scrollbar-thumb:hover { background: var(--color-white);
}
/* --- USSO EMBLEM (SHARED STYLES) --- */
        .usso-emblem {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 80px; /* Base size */
            height: 80px; /* Base size */
            background-color: var(--color-crimson-red);
            border: 2px solid var(--color-white);
            position: relative;
            overflow: hidden;
            transition: all var(--transition-speed) ease;
            box-shadow: 0 0 10px rgba(0,
  0,
  0,
  0.5);
}

        .usso-emblem: :before,
        .usso-emblem: :after {
            content: '';
            position: absolute;
            background-color: var(--color-white);
}
/* Emblem Design - Symmetrical, Aggressive, Elegant */
        .usso-emblem: :before {
            width: 20%;
            height: 120%;
            transform: rotate(45deg);
}
        .usso-emblem: :after {
            width: 20%;
            height: 120%;
            transform: rotate(-45deg);
}

        .usso-emblem-center {
            position: absolute;
            width: 40%;
            height: 40%;
            background-color: var(--color-black);
            border: 2px solid var(--color-crimson-red);
            transform: rotate(45deg);
            z-index: 1;
}
        .usso-emblem-text {
            position: absolute;
            font-family: var(--font-family-title);
            font-size: 0.9em;
            font-weight: 700;
            color: var(--color-white);
            z-index: 2;
}

        .usso-emblem.small { width: 50px; height: 50px;
}
        .usso-emblem.small .usso-emblem-text { font-size: 0.7em;
}
        .usso-emblem.small .usso-emblem-center { width: 30%; height: 30%;
}
/* --- SOUND & PERFORMANCE CONTROLS --- */
        .controls-panel {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: var(--z-index-modal);
            display: flex;
            gap: 10px;
            flex-direction: column;
            background: rgba(0,
  0,
  0,
  0.7);
            padding: 10px;
            border-radius: var(--border-radius-md);
            border: 1px solid var(--color-crimson-red);
}
        .control-group {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8em;
            color: var(--color-text-secondary);
}
        .control-group input[type="range"
] {
            width: 80px;
            -webkit-appearance: none;
            height: 3px;
            background: var(--color-dark-gray);
            border-radius: 2px;
            outline: none;
            cursor: pointer;
}
        .control-group input[type="range"
]: :-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--color-crimson-red);
            cursor: pointer;
            box-shadow: 0 0 5px var(--color-crimson-red);
}
        .control-group button {
            background: var(--color-dark-gray);
            color: var(--color-light-gray);
            border: 1px solid var(--color-crimson-red);
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 0.75em;
            transition: background var(--transition-speed), color var(--transition-speed);
}
        .control-group button:hover {
            background: var(--color-crimson-red);
            color: var(--color-white);
}
/* --- INTRO SEQUENCE --- */
        #intro-sequence {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--color-black);
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            z-index: var(--z-index-intro);
            opacity: 1;
            transition: opacity 2s ease-out;
            pointer-events: all;
            overflow: hidden;
}
        #intro-sequence.fade-out {
            opacity: 0;
            pointer-events: none;
}

        .intro-point-light {
            width: 0;
            height: 0;
            background-color: var(--color-crimson-red);
            border-radius: 50%;
            box-shadow: 0 0 100px var(--color-crimson-red);
            animation: expandPoint 3s ease-out 1s forwards;
            opacity: 0;
}
        @keyframes expandPoint {
  0% { width: 0; height: 0; opacity: 0; transform: scale(0);
  }
            50% { opacity: 1; transform: scale(1);
  }
            100% { width: 100px; height: 100px; opacity: 0.8;
  }
}

        .intro-globe-container {
            position: absolute;
            width: 400px;
            height: 400px;
            display: flex;
            justify-content: center;
            align-items: center;
            transform-style: preserve-3d;
            perspective: 1000px;
            opacity: 0;
            animation: fadeIn 2s ease-out 4s forwards;
}
        .intro-globe-frame {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 1px solid rgba(255,
  255,
  255,
  0.2);
            animation: rotateGlobe 40s linear infinite;
            transform-style: preserve-3d;
}
        .intro-globe-territory {
            position: absolute;
            width: 80%; /* Fictional continent size */
            height: 80%;
            background-color: var(--color-dark-gray); /* Placeholder landmass */
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(0,
  0,
  0,
  0.5);
            opacity: 0;
            animation: fadeIn 2s ease-out 5s forwards;
}
        .intro-usso-highlight {
            position: absolute;
            width: 60%;
            height: 60%;
            background-color: var(--color-crimson-red);
            border-radius: 50%;
            filter: blur(20px);
            box-shadow: 0 0 80px var(--color-crimson-red);
            opacity: 0;
            animation: fadeIn 2s ease-out 6s forwards, pulseRed 3s infinite alternate;
}
        .intro-city-lights {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            animation: fadeIn 2s ease-out 6.5s forwards;
}
        .intro-city-light {
            position: absolute;
            width: 4px;
            height: 4px;
            background-color: var(--color-white);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--color-white);
            opacity: 0;
            animation: fadeIn 1s ease-out forwards;
            animation-delay: var(--light-delay);
}

        .intro-text-overlay {
            position: absolute;
            text-align: center;
            font-family: var(--font-family-title);
            font-weight: 700;
            letter-spacing: 2px;
            z-index: 10;
            opacity: 0;
            text-shadow: 0 0 20px rgba(0,
  0,
  0,
  0.8);
}
        #intro-title-full {
            font-size: 5em;
            color: var(--color-white);
            animation: fadeInScale 1.5s ease-out 9s forwards;
}
        #intro-title-abbr {
            font-size: 2.5em;
            color: var(--color-crimson-red);
            margin-top: 10px;
            animation: fadeInScale 1.5s ease-out 9.5s forwards;
}
        #intro-title-great {
            font-size: 1.8em;
            color: var(--color-white);
            margin-top: 20px;
            animation: fadeInScale 1.5s ease-out 10s forwards;
}

        #intro-final-message {
            position: absolute;
            bottom: 5vh;
            text-align: center;
            font-size: 1.2em;
            color: var(--color-light-gray);
            line-height: 1.6;
            opacity: 0;
            animation: fadeIn 2s ease-out 13s forwards;
            padding: 20px;
            background: rgba(0,
  0,
  0,
  0.5);
            border-radius: var(--border-radius-md);
            border: 1px solid var(--color-crimson-red);
}
        #intro-final-message strong {
            display: block;
            font-size: 1.8em;
            color: var(--color-crimson-red);
            margin-bottom: 10px;
            text-shadow: 0 0 10px var(--color-crimson-red);
}
/* --- MAIN PORTAL --- */
        #main-portal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--color-black);
            opacity: 0;
            visibility: hidden;
            transition: opacity 1s ease-out, visibility 0s 1s;
            overflow: hidden; /* For initial state */
            display: grid;
            grid-template-areas: "nav header""nav content";
            grid-template-columns: 250px 1fr;
            grid-template-rows: auto 1fr;
            pointer-events: none;
            perspective: 1000px;
}
        #main-portal.active {
            opacity: 1;
            visibility: visible;
            transition: opacity 1s ease-out;
            pointer-events: all;
            overflow: hidden; /* Control content overflow later */
}
        #main-portal.active #portal-content {
            overflow-y: auto; /* Allow scrolling for content */
}
/* --- NAVIGATION --- */
        #main-nav {
            grid-area: nav;
            background-color: var(--color-black);
            border-right: 1px solid var(--color-dark-gray);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            box-shadow: 5px 0 20px rgba(0,
  0,
  0,
  0.5);
            z-index: var(--z-index-nav);
            transform: translateX(-100%);
            animation: slideInLeftNav 0.8s ease-out 1.5s forwards;
            opacity: 0;
}
        .nav-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
}
        .nav-header .usso-emblem {
            width: 60px;
            height: 60px;
}
        .nav-header .usso-emblem .usso-emblem-text { font-size: 0.8em;
}
        .nav-header .nav-title {
            font-family: var(--font-family-title);
            font-size: 1.5em;
            font-weight: 700;
            color: var(--color-white);
            letter-spacing: 1px;
            text-shadow: 0 0 5px rgba(255,
  255,
  255,
  0.2);
}

        #main-nav button {
            background: rgba(255,
  255,
  255,
  0.05);
            border: 1px solid var(--color-dark-gray);
            color: var(--color-light-gray);
            padding: 12px 18px;
            text-align: left;
            font-family: var(--font-family-body);
            font-size: 1em;
            border-radius: var(--border-radius-md);
            transition: all var(--transition-speed) ease;
            position: relative;
            overflow: hidden;
            outline: none;
}
        #main-nav button: :before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(220,
  20,
  60,
  0.15);
            transition: left var(--transition-speed) ease;
            z-index: 0;
}
        #main-nav button:hover: :before {
            left: 0;
}
        #main-nav button span {
            position: relative;
            z-index: 1;
}
        #main-nav button:hover {
            color: var(--color-white);
            border-color: var(--color-crimson-red);
            transform: translateX(5px);
            box-shadow: 0 0 10px var(--color-crimson-red);
}
        #main-nav button.active {
            background-color: var(--color-crimson-red);
            color: var(--color-white);
            font-weight: 700;
            border-color: var(--color-crimson-red);
            box-shadow: 0 0 15px var(--color-crimson-red);
}
/* --- HEADER --- */
        #portal-header {
            grid-area: header;
            background-color: var(--color-black);
            border-bottom: 1px solid var(--color-dark-gray);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 20px rgba(0,
  0,
  0,
  0.5);
            z-index: var(--z-index-nav);
            transform: translateY(-100%);
            animation: slideInTopHeader 0.8s ease-out 1.7s forwards;
            opacity: 0;
}
        .header-title {
            font-family: var(--font-family-title);
            font-size: 2.2em;
            font-weight: 700;
            color: var(--color-white);
            letter-spacing: 1.5px;
            text-shadow: 0 0 10px rgba(255,
  255,
  255,
  0.3);
}
        .header-status {
            font-size: 0.9em;
            color: var(--color-crimson-red);
            background-color: rgba(220,
  20,
  60,
  0.1);
            padding: 8px 15px;
            border-radius: var(--border-radius-md);
            border: 1px solid var(--color-crimson-red);
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
}
        .status-dot {
            width: 10px;
            height: 10px;
            background-color: var(--color-crimson-red);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--color-crimson-red);
            animation: pulseRed 1.5s infinite alternate;
}
/* --- MAIN CONTENT AREA --- */
        #portal-content {
            grid-area: content;
            background-color: var(--color-black);
            padding: 40px;
            overflow-y: auto; /* Controlled by JS for active state */
            position: relative;
            transform: translateX(100%);
            animation: slideInRightContent 0.8s ease-out 1.9s forwards;
            opacity: 0;
}
        .content-section {
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
}
        .content-section.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
}
        .section-header {
            font-family: var(--font-family-title);
            font-size: 2.5em;
            font-weight: 700;
            color: var(--color-white);
            margin-bottom: 40px;
            text-shadow: 0 0 15px rgba(255,
  255,
  255,
  0.4);
            border-bottom: 2px solid var(--color-crimson-red);
            padding-bottom: 15px;
            letter-spacing: 1px;
            text-align: center;
}
/* --- MAIN HERO (After Intro) --- */
        #hero-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 120px); /* Adjust for nav/header height */
            text-align: center;
            position: relative;
            overflow: hidden;
}
        .hero-globe-wrapper {
            width: 500px;
            height: 500px;
            position: relative;
            margin: 40px auto;
            transform-style: preserve-3d;
            perspective: 1000px;
            animation: rotateGlobe 60s linear infinite;
}
        .hero-globe-surface {
            width: 100%;
            height: 100%;
            background-color: var(--color-dark-gray);
            border-radius: 50%;
            box-shadow: 0 0 50px rgba(0,
  0,
  0,
  0.8), inset 0 0 50px rgba(255,
  255,
  255,
  0.05);
            position: absolute;
            top: 0; left: 0;
            transform-style: preserve-3d;
            overflow: hidden;
}
        .hero-globe-usso-territory {
            position: absolute;
            top: 20%; left: 30%; /* Example position */
            width: 50%;
            height: 60%;
            background-color: var(--color-crimson-red);
            filter: blur(25px);
            border-radius: 50%;
            box-shadow: 0 0 100px var(--color-crimson-red);
            animation: pulseRed 4s infinite alternate;
}
        .hero-globe-city-light {
            position: absolute;
            width: 6px;
            height: 6px;
            background-color: var(--color-white);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--color-white);
            opacity: 0.8;
            animation: lightFlicker 2s infinite alternate var(--light-delay);
}
        .hero-globe-city-light:nth-child(1) { top: 25%; left: 40%; --light-delay: 0.2s;
}
        .hero-globe-city-light:nth-child(2) { top: 55%; left: 70%; --light-delay: 0.7s;
}
        .hero-globe-city-light:nth-child(3) { top: 70%; left: 20%; --light-delay: 1.1s;
}
        .hero-globe-city-light:nth-child(4) { top: 40%; left: 10%; --light-delay: 0.5s;
}
        .hero-globe-city-light:nth-child(5) { top: 10%; left: 80%; --light-delay: 1.5s;
}

        .hero-text {
            font-family: var(--font-family-title);
            margin-top: 20px;
}
        .hero-text h1 {
            font-size: 3.5em;
            color: var(--color-white);
            text-shadow: 0 0 15px rgba(255,
  255,
  255,
  0.4);
            letter-spacing: 2px;
}
        .hero-text h2 {
            font-size: 2em;
            color: var(--color-crimson-red);
            margin-top: 5px;
            text-shadow: 0 0 10px var(--color-crimson-red);
}
        .hero-text p {
            font-size: 1.2em;
            color: var(--color-light-gray);
            margin-top: 15px;
            font-style: italic;
}
        .hero-buttons {
            margin-top: 40px;
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
}
        .hero-buttons button {
            background: var(--color-dark-gray);
            border: 1px solid var(--color-crimson-red);
            padding: 15px 30px;
            border-radius: var(--border-radius-md);
            font-family: var(--font-family-title);
            font-size: 1.1em;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--color-white);
            transition: all var(--transition-speed) ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0,
  0,
  0,
  0.5);
}
        .hero-buttons button: :before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(220,
  20,
  60,
  0.3);
            transition: left var(--transition-speed) ease;
}
        .hero-buttons button:hover: :before {
            left: 0;
}
        .hero-buttons button:hover {
            border-color: var(--color-white);
            color: var(--color-crimson-red);
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 0 20px var(--color-crimson-red);
}
/* --- NATIONAL IDENTITY SECTION --- */
        #national-identity-section {
            text-align: center;
}
        .national-identity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px,
  1fr));
            gap: 30px;
            margin-top: 40px;
}
        .identity-card {
            background: var(--color-dark-gray);
            border: 1px solid var(--color-crimson-red);
            border-radius: var(--border-radius-lg);
            padding: 30px;
            box-shadow: 0 0 15px rgba(0,
  0,
  0,
  0.5);
            transition: transform var(--transition-speed), box-shadow var(--transition-speed);
}
        .identity-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 0 25px var(--color-crimson-red);
}
        .identity-card strong {
            display: block;
            font-family: var(--font-family-title);
            font-size: 1.8em;
            color: var(--color-white);
            margin-bottom: 10px;
}
        .identity-card span {
            font-size: 1em;
            color: var(--color-text-secondary);
}
        .national-flag-display {
            width: 400px;
            height: 250px;
            margin: 50px auto;
            background-color: var(--color-black);
            border: 2px solid var(--color-white);
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.5s ease;
            box-shadow: 0 0 20px rgba(0,
  0,
  0,
  0.5);
            perspective: 1000px;
            transform-style: preserve-3d;
}
        .national-flag-display:hover {
            transform: translateY(-10px) rotateY(5deg);
}
        .flag-content {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0; left: 0;
            background-image:
                linear-gradient(to right, var(--color-crimson-red) 33%, var(--color-white) 33%, var(--color-white) 66%, var(--color-black) 66%);
            animation: flagWave 6s infinite alternate ease-in-out;
            transform-origin: 0% 50%;
}
        .flag-emblem-overlay {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%,
  -50%);
            width: 100px;
            height: 100px;
            filter: drop-shadow(0 0 10px rgba(0,
  0,
  0,
  0.7));
            transition: opacity var(--transition-speed) ease;
}
        .flag-emblem-overlay .usso-emblem {
            width: 100%; height: 100%;
            border-width: 4px;
            background-color: transparent;
            box-shadow: none;
}
        .flag-emblem-overlay .usso-emblem: :before,
        .flag-emblem-overlay .usso-emblem: :after { background-color: var(--color-white);
}
        .flag-emblem-overlay .usso-emblem-center { background-color: var(--color-black); border-color: var(--color-crimson-red);
}
        .flag-emblem-overlay .usso-emblem-text { color: var(--color-white); font-size: 1em;
}
/* Flag Info Panel (Modal) */
        .flag-info-panel, .timeline-info-panel, .archive-document-viewer {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%,
  -50%) scale(0.9);
            background: var(--color-black);
            border: 2px solid var(--color-crimson-red);
            border-radius: var(--border-radius-lg);
            padding: 50px;
            max-width: 700px;
            max-height: 90vh;
            overflow-y: auto;
            z-index: var(--z-index-modal);
            box-shadow: 0 0 40px rgba(0,
  0,
  0,
  0.7),
  0 0 30px var(--color-crimson-red);
            display: none;
            opacity: 0;
            transition: all 0.6s ease-out;
}
        .flag-info-panel.active, .timeline-info-panel.active, .archive-document-viewer.active {
            display: block;
